{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Briqwall",
  "identifier": "de.briqwall.firewall",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../ui"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Briqwall",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "backgroundColor": "#f4f5f8"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Briqwall",
    "category": "Utility",
    "copyright": "© 2026 Briqwall",
    "shortDescription": "A firewall you don’t have to configure",
    "longDescription": "Application firewall for Windows built on the Windows Filtering Platform. Decides by where a program comes from instead of ports and only asks when it really matters.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/briqwall-service"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English",
          "German"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh",
        "compression": "lzma"
      }
    },
    "license": "MIT OR Apache-2.0"
  },
  "mainBinaryName": "briqwall"
}